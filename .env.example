# Deixe vazio em desenvolvimento para usar o proxy /api do Vite.
# Em produção, informe a URL pública do backend quando ele estiver em outro domínio.
VITE_API_BASE_URL=/api/v1

# Serviço temporário de consulta de endereço por CEP usado até a API privada assumir o proxy.
VITE_CEP_API_BASE_URL=https://viacep.com.br/ws
