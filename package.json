{
  "name": "rent4moms-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run guard:no-new-runtime-mocks && npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:dist": "node scripts/verify-build.mjs",
    "qa:production": "npm run check && npm run verify:dist",
    "guard:no-new-runtime-mocks": "node scripts/check-no-new-runtime-mocks.mjs",
    "stage:a:inventory": "node scripts/stage-a-inventory.mjs",
    "stage:b:verify": "npm run check",
    "stage:c:verify": "npm run check",
    "stage:d:verify": "npm run check",
    "stage:e:verify": "npm run check",
    "stage:f:verify": "npm run check",
    "stage:g:verify": "npm run check",
    "stage:h:verify": "npm run check",
    "stage:i:docs": "node scripts/stage-i-docs-check.mjs",
    "stage:i:verify": "npm run check && npm run stage:i:docs",
    "stage:j:zero-mock": "node scripts/stage-j-zero-mock-check.mjs",
    "stage:j:static": "npm run stage:j:zero-mock && node scripts/stage-j-release-check.mjs",
    "stage:j:verify": "npm run qa:production && npm run stage:i:docs && npm run stage:j:static",
    "pages:prepare": "node scripts/prepare-github-pages.mjs",
    "pages:build": "npm run stage:j:verify && npm run pages:prepare"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
